# GitHub Personal Access Token (classic or fine-grained with repo/read/write scopes as needed)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_token_here

# GitHub Base API URL (defaults to https://api.github.com, or enterprise instance)
GITHUB_API_URL=https://api.github.com

# 3-Tier Read-Only Safety Mode (true/false)
GITHUB_READ_ONLY=false

# Expose all 83 tools instead of the default 5-tool hybrid architecture (true/false)
GITHUB_EXPOSE_ALL_TOOLS=false

# Default output format: 'markdown' (token-saving tables/text) or 'json'
MCP_OUTPUT_FORMAT=markdown

